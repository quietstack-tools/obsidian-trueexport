<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Hand-authored word/styles.xml (NOT generated by the docx write-library, which
  never emits the paragraph-mark <w:rPr> nested inside <w:pPr> that real Word /
  LibreOffice produce). Each style below carries BOTH a paragraph-mark <w:rPr>
  (inside <w:pPr>) and the style's real run <w:rPr> — with deliberately
  different values — so the extractor is forced to pick the correct one.
  Regression fixture for Finding 1.
-->
<w:styles xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main">
  <w:docDefaults>
    <w:rPrDefault>
      <w:rPr>
        <w:rFonts w:ascii="Georgia" w:hAnsi="Georgia" w:cs="Georgia"/>
        <w:color w:val="222222"/>
        <w:sz w:val="24"/>
        <w:szCs w:val="24"/>
      </w:rPr>
    </w:rPrDefault>
    <w:pPrDefault>
      <w:pPr>
        <w:spacing w:after="200" w:line="276" w:lineRule="auto"/>
        <!-- paragraph-mark run props: MUST NOT be read as the Normal run style -->
        <w:rPr>
          <w:color w:val="BBBBBB"/>
          <w:sz w:val="8"/>
        </w:rPr>
      </w:pPr>
    </w:pPrDefault>
  </w:docDefaults>
  <w:style w:type="paragraph" w:styleId="Heading1">
    <w:name w:val="heading 1"/>
    <w:basedOn w:val="Normal"/>
    <w:next w:val="Normal"/>
    <w:qFormat/>
    <w:pPr>
      <w:keepNext/>
      <w:spacing w:before="320" w:after="160"/>
      <!-- paragraph-mark run props: MUST NOT be read as the Heading 1 run style -->
      <w:rPr>
        <w:color w:val="AAAAAA"/>
        <w:sz w:val="10"/>
      </w:rPr>
    </w:pPr>
    <w:rPr>
      <w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/>
      <w:b/>
      <w:bCs/>
      <w:color w:val="AA0011"/>
      <w:sz w:val="52"/>
      <w:szCs w:val="52"/>
    </w:rPr>
  </w:style>
</w:styles>
